# アプリケーション設定
PROJECT_NAME=mini-aigw
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-secret-key-change-in-production

# リバースプロキシ・ベースパス設定
# サブパス配下で公開する場合 (例: https://sample.com/aigw/):
# BASE_PATH=/aigw
#
# 公開ベースURL（リバースプロキシやカスタムドメイン使用時に原本DLリンクやOIDCリダイレクトのベースURLとして指定。BASE_PATHの自動抽出にも使用されます）
# PUBLIC_BASE_URL=https://sample.com/aigw

# SQLite データベース
DATABASE_URL=sqlite:///data/aigw.db

# AWS 設定
AWS_REGION=ap-northeast-1
BEDROCK_KB_ID=your-bedrock-knowledge-base-id
BEDROCK_DATA_SOURCE_ID=your-bedrock-data-source-id
KNOWLEDGE_S3_BUCKET=your-s3-knowledge-bucket
DEFAULT_MODEL_ID=jp.amazon.nova-2-lite-v1:0

# 推論パラメータ・ガードレール設定
# DEFAULT_TEMPERATURE=0.7       # 未指定時のデフォルト温度 (0.0〜1.0)
DEFAULT_MAX_TOKENS=4096         # 未指定時のデフォルト最大トークン数
MAX_ALLOWED_TOKENS=8192         # AIGW が許容する最大出力トークン数 (ハードキャップ)

# RAG 設定
RAG_SCORE_THRESHOLD=0.3
RAG_NUMBER_OF_RESULTS=8

# ドキュメント抽出 CLI パス (任意: 未指定時は PATH 上の "xberg" を探索、見つからない場合は平文フォールバック)
# XBERG_PATH=/usr/local/bin/xberg
# (Windows の場合: XBERG_PATH=C:\tools\xberg.exe)
# xberg の OCR (既定 false。スキャン PDF の文字起こしが必要な場合のみ true。画像抽出は常に無効)
# XBERG_OCR=false
# xberg 1ファイルあたりの抽出タイムアウト秒数
# XBERG_TIMEOUT_SEC=60
# 1リクエスト内の添付ファイル抽出テキスト合計文字数の上限 (超過分は切り詰め・省略。0 以下で無制限)
# MAX_TOTAL_ATTACHMENT_CHARS=50000

# /v1/chat/completions のリクエストボディ上限 (MB。超過時は 413)
# CHAT_MAX_BODY_MB=30
# HTTP サーバーの書き込みタイムアウト秒数 (長時間のストリーミング推論向け。nginx の proxy_read_timeout 以下を推奨)
# SERVER_WRITE_TIMEOUT_SEC=300

# エラーログ (JSON Lines 形式で追記。既定: ${DATA_DIR}/logs/error.log)
# ERROR_LOG_FILE=data/logs/error.log

# mini-id (OIDC IdP) 設定（SSO 連携時）
# OIDC_ISSUER=https://mini-id.internal
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URI=http://localhost:8000/auth/oidc/callback
# OIDC_SCOPES="openid profile email groups"
# OIDC_END_SESSION_ENDPOINT=https://mini-id.internal/protocol/openid-connect/logout
